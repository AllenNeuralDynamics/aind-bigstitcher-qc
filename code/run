#!/usr/bin/env bash

set -ex

export AWS_REGION=${9:-"us-west-2"}
export AWS_MAX_ATTEMPTS=${10:-"10"}
export AWS_RETRY_MODE=${11:-"standard"}

output_path=${2:-}
if [[ -z "$output_path" ]]; then
  processing_json="/data/processing.json"

  if [[ ! -f "$processing_json" ]]; then
    echo "Output path is blank and processing metadata was not found at $processing_json" >&2
    exit 1
  fi

  if ! s3_xml_paths=$(jq -c '
    [
      .data_processes[]?.code.parameters.s3_xml_path?
      | select(type == "string" and length > 0)
    ]
    | unique
  ' "$processing_json"); then
    echo "Unable to parse $processing_json while deriving the output path" >&2
    exit 1
  fi

  s3_xml_path_count=$(jq -r 'length' <<<"$s3_xml_paths")
  if [[ "$s3_xml_path_count" -ne 1 ]]; then
    echo "Expected exactly one non-empty s3_xml_path in $processing_json, found $s3_xml_path_count" >&2
    exit 1
  fi

  s3_xml_path=$(jq -r '.[0]' <<<"$s3_xml_paths")
  if [[ ! "$s3_xml_path" =~ ^s3://[^/]+/.+/.+$ ]]; then
    echo "Invalid s3_xml_path in $processing_json: $s3_xml_path" >&2
    exit 1
  fi

  output_path="${s3_xml_path%/*}/overlay"
fi

time java \
  -Xms${12:-"200"}g \
  -Xmx${12:-"200"}g \
  -Djava.awt.headless=true -jar \
/aind-bigstitcher-qc/code/bigstitcher-qc/target/bigstitcher-qc-1.0.0-SNAPSHOT-fuse-composite.jar \
  "$1" \
  "$output_path" \
  --anisotropy ${3:-"1.0"} \
  --downsampling ${4:-"8"} \
  --interpolation ${5:-"1"} \
  --max-downsampling-levels ${6:-"5"} \
  --display-max ${7:-"100"} \
  --color-mode ${8:-"illumination"}
